# 微信订阅消息配置示例
# 复制为 .env 或直接 export 到 shell 后启动服务器
#
#   cp .env.example .env && go run main.go    # 服务器会自动加载 .env
#
# 获取方式：
#   WECHAT_APPID        微信公众平台 → 开发管理 → 开发设置 → AppID
#   WECHAT_SECRET       同上页面 → AppSecret（点「重置」获取）
#   WECHAT_TEMPLATE_ID  微信公众平台 → 功能 → 订阅消息 → 选用模板
#
# 前提：企业主体小程序（个人主体无法使用订阅消息）
export WECHAT_APPID=在这里填入你的AppID
export WECHAT_SECRET=在这里填入你的AppSecret
export WECHAT_TEMPLATE_ID=在这里填入你的模板ID

# ==================== 微信支付 / 提现（服务器统一处理） ====================
# 微信支付商户号（微信商户平台 → 账户中心 → 商户信息）
export WECHAT_PAY_MCH_ID=在这里填入你的商户号
# 微信支付 APIv3 密钥（商户平台 → 账户中心 → API安全 → 设置APIv3密钥，32位）
export WECHAT_PAY_MCH_KEY=在这里填入你的APIv3密钥
# 商户 API 证书序列号（商户平台 → 账户中心 → API安全 → 申请API证书 查看）
export WECHAT_PAY_SERIAL_NO=在这里填入证书序列号
# 商户 API 私钥 apiclient_key.pem 的文件路径（申请 API 证书时下载）
export WECHAT_PAY_PRIVATE_KEY_PATH=/path/to/apiclient_key.pem
# 微信支付公钥 PEM 文件路径（商户平台 → 账户中心 → API安全 → 微信支付公钥，下载后转 PEM）
export WECHAT_PAY_PUBLIC_KEY_PATH=/path/to/wechatpay_public.pem
# 企业银行卡号：模拟模式提现打款收款账户（真实模式提现直接转用户微信零钱）
export WECHAT_PAY_BANK_CARD=在这里填入企业银行卡号
# 支付结果回调地址（真实对接微信支付时需公网可达 HTTPS，路径固定为 /api/v1/pay/notify）
export WECHAT_PAY_NOTIFY_URL=https://你的域名/api/v1/pay/notify

# 无理由退货期（天）：订单支付后佣金延迟到账，期内退款佣金取消（默认 7）
export COMMISSION_SETTLE_DAYS=7

# ==================== 硬件开放平台（健康/养老设备对接） ====================
# 平台：https://health.yiyangiot.com/DeviceMonitor/（appId/appKey 在平台开户时生成）
#   - 配置后：小程序绑定设备时服务器实时调用 deviceLocationQuery.action 校验 IMEI 并获取 UID，
#     保证「一台硬件只归属一个用户」的精确绑定。
#   - 未配置：进入模拟模式（UID 由 IMEI 派生），本地联调整条链路不受影响。
# 平台「个人中心 → 数据上传url」填写：http://<服务器公网IP或域名>/api/v1/hw/push
export HARDWARE_APPID=
export HARDWARE_APPKEY=
# 平台接口根地址（一般无需修改）
export HARDWARE_API_BASE=https://health.yiyangiot.com/DeviceMonitor/

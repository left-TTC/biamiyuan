/* pages/deviceAdd/deviceAdd.wxss */
page {
    height: 100vh;
    display: flex;
    flex-direction: column;
    background: #f5f6fa;
}

.scrollarea {
    flex: 1;
    overflow-y: auto;
}

/* 类型网格 */
.type-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
}

.type-cell {
    width: 32%;
    background: #ffffff;
    border-radius: 20rpx;
    padding: 24rpx 0;
    margin-bottom: 16rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    border: 3rpx solid transparent;
}

.type-cell.active {
    border-color: #1e6fff;
    background: #f0f5ff;
}

.type-icon {
    width: 76rpx;
    height: 76rpx;
    border-radius: 20rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 40rpx;
    color: #ffffff;
}

.type-name {
    margin-top: 12rpx;
    font-size: 22rpx;
    color: #4b5563;
}

.type-cell.active .type-name {
    color: #1e6fff;
    font-weight: 600;
}

/* 表单 */
.form-row {
    display: flex;
    align-items: center;
    padding: 24rpx 0;
    border-bottom: 1rpx solid #f0f1f3;
}

.form-row:last-child {
    border-bottom: none;
}

.form-label {
    width: 180rpx;
    font-size: 28rpx;
    color: #1f2329;
    flex: none;
}

.form-input {
    flex: 1;
    font-size: 28rpx;
}

.gen-sn {
    flex: none;
    font-size: 24rpx;
    color: #1e6fff;
    padding: 8rpx 20rpx;
    border: 1rpx solid #1e6fff;
    border-radius: 24rpx;
}

/* 说明 */
.tip-title {
    font-size: 28rpx;
    font-weight: 600;
    color: #1f2329;
    margin-bottom: 12rpx;
}

.tip-item {
    font-size: 24rpx;
    color: #6b7280;
    line-height: 1.9;
}

.save-btn {
    margin-top: 32rpx;
}

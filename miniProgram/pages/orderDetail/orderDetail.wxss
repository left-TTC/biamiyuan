/* pages/orderDetail/orderDetail.wxss */
page {
    height: 100vh;
    display: flex;
    flex-direction: column;
    background: #f5f6fa;
}

.scrollarea {
    flex: 1;
    overflow-y: auto;
}

/* 状态头部 */
.status-card {
    display: flex;
    align-items: center;
    border-radius: 24rpx;
    margin-top: 20rpx;
    padding: 40rpx 32rpx;
    color: #ffffff;
}

.status-pending {
    background: linear-gradient(135deg, #f97316, #fb923c);
}

.status-paid {
    background: linear-gradient(135deg, #1e6fff, #4d8dff);
}

.status-shipped {
    background: linear-gradient(135deg, #8b5cf6, #a78bfa);
}

.status-done {
    background: linear-gradient(135deg, #10b981, #34d399);
}

.status-canceled {
    background: linear-gradient(135deg, #9ca3af, #b0b6bf);
}

.status-emoji {
    font-size: 72rpx;
    margin-right: 24rpx;
}

.status-title {
    font-size: 40rpx;
    font-weight: 700;
}

.status-desc {
    margin-top: 8rpx;
    font-size: 24rpx;
    opacity: 0.92;
}

/* 地址 */
.addr-card {
    display: flex;
    align-items: center;
}

.addr-icon {
    font-size: 40rpx;
    margin-right: 20rpx;
}

.addr-line1 {
    display: flex;
    align-items: center;
}

.addr-name {
    font-size: 30rpx;
    font-weight: 600;
}

.addr-phone {
    margin-left: 16rpx;
    font-size: 26rpx;
    color: #4b5563;
}

.addr-detail {
    margin-top: 8rpx;
    font-size: 24rpx;
    color: #6b7280;
}

/* 商品 */
.goods-row {
    display: flex;
    align-items: center;
    padding: 12rpx 0;
}

.goods-row:first-child {
    padding-top: 0;
}

.goods-pic {
    width: 130rpx;
    height: 130rpx;
    flex: none;
    border-radius: 16rpx;
    display: flex;
    align-items: center;
    justify-content: center;
}

.goods-emoji {
    font-size: 60rpx;
}

.goods-img {
    width: 100%;
    height: 100%;
}

.goods-info {
    flex: 1;
    margin-left: 20rpx;
}

.goods-name {
    font-size: 28rpx;
    font-weight: 600;
    color: #1f2329;
}

.goods-foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-top: 12rpx;
}

.goods-count {
    font-size: 26rpx;
    color: #9aa1ab;
}

.total-line {
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
    border-top: 1rpx solid #f0f1f3;
    margin-top: 16rpx;
    padding-top: 20rpx;
    font-size: 24rpx;
    color: #6b7280;
}

.total-line .price {
    margin-left: 12rpx;
}

/* 订单信息 */
.info-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12rpx 0;
    font-size: 26rpx;
}

.info-label {
    color: #9aa1ab;
    flex: none;
}

.info-value {
    color: #4b5563;
    text-align: right;
    word-break: break-all;
}

.invite-tip {
    font-size: 24rpx;
    color: #1e6fff;
    text-align: center;
}

/* 底部 */
.footer {
    background: #ffffff;
    padding: 16rpx 24rpx;
    box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.footer-btns {
    display: flex;
    justify-content: flex-end;
}

.footer-btn {
    margin-left: 20rpx;
    height: 72rpx;
    line-height: 68rpx;
    padding: 0 36rpx;
    min-width: 180rpx;
}

.confirm-btn {
    width: 100%;
}

/* 规格与来源 */
.goods-attrs {
    margin-top: 6rpx;
    font-size: 22rpx;
    color: #9aa1ab;
}

.tag-service {
    background: rgba(14, 165, 233, 0.12);
    color: #0ea5e9;
    font-size: 18rpx;
    margin-left: 8rpx;
}

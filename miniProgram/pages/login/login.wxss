/* pages/login/login.wxss */
page {
    height: 100vh;
    background: linear-gradient(180deg, #eef4ff 0%, #f5f6fa 40%);
}

.login-page {
    min-height: 100vh;
    padding: 0 56rpx;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
}

/* 品牌区 */
.brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 120rpx;
}

.brand-icon {
    width: 140rpx;
    height: 140rpx;
    border-radius: 36rpx;
    background: linear-gradient(135deg, #1e6fff, #4d8dff);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 72rpx;
    box-shadow: 0 12rpx 32rpx rgba(30, 111, 255, 0.25);
}

.brand-title {
    margin-top: 28rpx;
    font-size: 44rpx;
    font-weight: 700;
    color: #1f2329;
}

.brand-sub {
    margin-top: 10rpx;
    font-size: 24rpx;
    color: #9aa1ab;
}

/* 登录 / 注册 切换 */
.mode-tabs {
    display: flex;
    margin-top: 56rpx;
    background: #ffffff;
    border-radius: 44rpx;
    padding: 8rpx;
    box-shadow: 0 4rpx 16rpx rgba(30, 111, 255, 0.06);
}

.mode-tab {
    flex: 1;
    height: 72rpx;
    line-height: 72rpx;
    text-align: center;
    font-size: 28rpx;
    color: #6b7280;
    border-radius: 36rpx;
    transition: all 0.2s;
}

.mode-tab.active {
    background: linear-gradient(135deg, #1e6fff, #4d8dff);
    color: #ffffff;
    font-weight: 600;
}

/* 表单 */
.form {
    margin-top: 64rpx;
}

.form-item {
    display: flex;
    align-items: center;
    background: #ffffff;
    border-radius: 20rpx;
    padding: 0 28rpx;
    height: 104rpx;
    margin-bottom: 24rpx;
    box-shadow: 0 4rpx 16rpx rgba(30, 111, 255, 0.05);
}

.item-icon {
    font-size: 32rpx;
    margin-right: 16rpx;
    flex: none;
}

.item-input {
    flex: 1;
    font-size: 28rpx;
}

.code-btn {
    flex: none;
    font-size: 26rpx;
    color: #1e6fff;
    font-weight: 600;
    padding: 12rpx 0 12rpx 24rpx;
    border-left: 1rpx solid #e5e7eb;
}

.code-btn.disabled {
    color: #b0b6bf;
}

/* 协议 */
.agree-row {
    display: flex;
    align-items: center;
    margin: 8rpx 0 40rpx;
}

.check {
    width: 34rpx;
    height: 34rpx;
    border-radius: 50%;
    border: 2rpx solid #d0d5dd;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    font-size: 20rpx;
    flex: none;
}

.check.on {
    background: #1e6fff;
    border-color: #1e6fff;
}

.agree-text {
    margin-left: 14rpx;
    font-size: 22rpx;
    color: #9aa1ab;
}

.login-btn {
    height: 92rpx;
    line-height: 92rpx;
    font-size: 32rpx;
    font-weight: 600;
    border-radius: 46rpx;
}

/* 演示提示 */
.demo-tip {
    margin-top: 40rpx;
    background: #fff7e6;
    border: 1rpx dashed #f59e0b;
    border-radius: 20rpx;
    padding: 24rpx;
}

.demo-title {
    font-size: 26rpx;
    font-weight: 600;
    color: #b45309;
}

.demo-row {
    margin-top: 12rpx;
    font-size: 24rpx;
    color: #92400e;
    line-height: 1.7;
}

.demo-code {
    font-weight: 700;
    color: #1e6fff;
}

.demo-fill {
    display: inline-block;
    margin-top: 16rpx;
    font-size: 24rpx;
    color: #1e6fff;
    border: 1rpx solid #1e6fff;
    border-radius: 28rpx;
    padding: 8rpx 24rpx;
}

/* 底部 */
.footer-tip {
    margin-top: auto;
    padding: 48rpx 0 60rpx;
    text-align: center;
    font-size: 22rpx;
    color: #c0c6cf;
}

/* 微信手机号快捷填充（官方组件） */
.quickfill {
    width: 100%;
    margin: -4rpx 0 24rpx;
}

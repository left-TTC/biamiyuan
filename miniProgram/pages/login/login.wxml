<!-- pages/login/login.wxml -->
<view class="login-page">
    <!-- 顶部品牌区 -->
    <view class="brand">
        <view class="brand-icon">🛡️</view>
        <view class="brand-title">安全监护商城</view>
        <view class="brand-sub">账号须在服务器注册 · 注册即会员</view>
    </view>

    <!-- 登录 / 注册 切换 -->
    <view class="mode-tabs">
        <view
            class="mode-tab {{mode === 'login' ? 'active' : ''}}"
            data-mode="login"
            bindtap="switchMode"
        >登录</view>
        <view
            class="mode-tab {{mode === 'register' ? 'active' : ''}}"
            data-mode="register"
            bindtap="switchMode"
        >注册</view>
    </view>

    <!-- 表单 -->
    <view class="form">
        <view class="form-item">
            <view class="item-icon">📱</view>
            <input
                class="item-input"
                type="text"
                placeholder="请输入手机号"
                value="{{phone}}"
                bindinput="onPhone"
                maxlength="20"
            />
        </view>
        <!-- 微信官方手机号快捷填充：点击弹出微信手机号一键填入 -->
        <phone-number-quickfill
            class="quickfill"
            placeholder="使用微信手机号一键填入"
            bindgetphonenumber="onGetPhoneNumber"
        />

        <view class="form-item">
            <view class="item-icon">🔑</view>
            <input
                class="item-input code-input"
                type="text"
                placeholder="请输入验证码"
                value="{{code}}"
                bindinput="onCode"
                maxlength="6"
            />
            <view
                class="code-btn {{counting ? 'disabled' : ''}}"
                bindtap="sendCode"
            >{{counting ? countdown + 's' : '获取验证码'}}</view>
        </view>

        <view class="agree-row" bindtap="toggleAgree">
            <view class="check {{agree ? 'on' : ''}}">
                <text wx:if="{{agree}}">✓</text>
            </view>
            <text class="agree-text">我已阅读并同意《会员服务协议》和《隐私政策》</text>
        </view>

        <button class="btn btn-primary login-btn" bindtap="submit" loading="{{submitting}}">{{mode === 'register' ? '注 册' : '登 录'}}</button>
    </view>

    <!-- 演示提示 -->
    <view class="demo-tip">
        <view class="demo-title">🎬 演示环境说明</view>
        <view class="demo-row">手机号随便填（如 test）即可，验证码怎么填都通过（可不填）</view>
        <view class="demo-row">新手机号选「注册」，已注册手机号选「登录」</view>
        <view class="demo-fill" bindtap="fillDemo">一键填入 test / {{smsCode}}</view>
    </view>

    <view class="footer-tip">安全监护 · 守护您的家</view>
</view>

<!-- pages/user/user.wxml -->
<navigation-bar title="我的" back="{{false}}" color="black" background="#F5F6FA"></navigation-bar>

<scroll-view class="scrollarea" scroll-y>
    <view class="page">
        <!-- 用户信息卡片 -->
        <view class="user-card">
            <block wx:if="{{isLogin}}">
                <image class="avatar" src="{{user.avatarUrl}}" mode="aspectFill" bindtap="editProfile"></image>
                <view class="user-info">
                    <view class="user-name" bindtap="editProfile">{{user.nickName}}</view>
                    <view class="user-tag-row">
                        <view class="invite-code" bindtap="copyCode">邀请码 {{user.promoterCode}}</view>
                    </view>
                    <view class="user-phone">
                        <image class="phoneicon" src="/assets/icons/phone.svg"></image>                    
                        {{user.phone}}
                    </view>
                </view>
            </block>
            <block wx:else>
                <view class="avatar avatar-placeholder">👤</view>
                <view class="user-info">
                    <view class="user-name">未登录</view>
                    <view class="login-tip-text">登录后可下单、邀请好友、赚取佣金</view>
                    <view class="login-entry" bindtap="goLogin">手机号登录 / 注册</view>
                </view>
            </block>
        </view>

        <!-- 收益概览 -->
        <view class="balance-card" bindtap="goCommission">
            <view class="balance-item">
                <view class="balance-num">¥{{balance}}</view>
                <view class="balance-label">可提现余额</view>
            </view>
            <view class="balance-divider"></view>
            <view class="balance-item">
                <view class="balance-num">{{teamCount}}</view>
                <view class="balance-label">邀请好友</view>
            </view>
            <view class="balance-divider"></view>
            <view class="balance-item">
                <view class="balance-arrow">›</view>
                <view class="balance-label">佣金明细</view>
            </view>
        </view>

        <!-- 我的订单 -->
        <view class="card order-card">
            <view class="order-header" bindtap="goOrderList" data-status="all">
                <text class="order-title">我的订单</text>
                <text class="order-more">全部订单 ›</text>
            </view>
            <view class="order-tabs">
                <view class="order-tab" bindtap="goOrderList" data-status="pending">
                    <image class="order-icon" src="/assets/icons/pay.svg"></image>
                    <text class="order-label">待付款</text>
                    <view wx:if="{{orderCounts.pending}}" class="badge">{{orderCounts.pending}}</view>
                </view>
                <view class="order-tab" bindtap="goOrderList" data-status="paid">
                    <image class="order-icon" src="/assets/icons/send.svg"></image>
                    <text class="order-label">待发货</text>
                </view>
                <view class="order-tab" bindtap="goOrderList" data-status="shipped">
                    <image class="order-icon" src="/assets/icons/sended.svg"></image>
                    <text class="order-label">待收货</text>
                </view>
                <view class="order-tab" bindtap="goOrderList" data-status="done">
                    <image class="order-icon" src="/assets/icons/Completed.svg"></image>
                    <text class="order-label">已完成</text>
                </view>
            </view>
        </view>

        <!-- 邀请中心（统一邀请机制） -->
        <view class="card">
            <view class="menu-item" bindtap="goInvite">
                <image class="menu-icon" src="/assets/icons/invite.svg"></image>
                <text class="menu-name">邀请好友</text>
                <text class="menu-desc">分享邀请 · 每笔 {{rateText}} 佣金</text>
                <text class="menu-arrow">›</text>
            </view>
            <view class="divider"></view>
            <view class="menu-item" bindtap="goWithdraw">
                <image class="menu-icon" src="/assets/icons/balance-o.svg"></image>
                <text class="menu-name">余额提现</text>
                <text class="menu-desc">微信零钱 / 银行卡</text>
                <text class="menu-arrow">›</text>
            </view>
        </view>

        <!-- 团队（独立栏目） -->
        <view class="card">
            <view class="menu-item" bindtap="goTeam">
                <image class="menu-icon" src="/assets/icons/team.svg"></image>
                <text class="menu-name">我的团队</text>
                <text class="menu-desc">{{myTeamName || '创建团队 · 发布服务'}}</text>
                <text class="menu-arrow">›</text>
            </view>
        </view>

        <!-- 其他 -->
        <view class="card">
            <view class="menu-item" bindtap="goAddress">
                <image class="menu-icon" src="/assets/icons/location.svg"></image>
                <text class="menu-name">收货地址</text>
                <text class="menu-arrow">›</text>
            </view>
            <view class="divider"></view>
            <view class="menu-item" bindtap="goSupport">
                <image class="menu-icon" src="/assets/icons/team.svg"></image>
                <text class="menu-name">联系客服</text>
                <text class="menu-desc">团队服务 / 商品咨询</text>
                <text class="menu-arrow">›</text>
            </view>
        </view>

        <!-- 退出登录（仅登录后显示） -->
        <view wx:if="{{isLogin}}" class="card logout-card">
            <view class="menu-item center" bindtap="logout">
                <text class="logout-text">退出登录</text>
            </view>
        </view>
    </view>
</scroll-view>

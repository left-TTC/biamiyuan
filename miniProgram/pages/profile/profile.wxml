<!-- pages/profile/profile.wxml -->
<navigation-bar title="编辑资料" back="{{true}}" color="black" background="#F5F6FA"></navigation-bar>

<view class="page">
    <!-- 头像 -->
    <view class="card avatar-card">
        <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
            <image class="avatar" src="{{avatarUrl}}" mode="aspectFill"></image>
            <view class="avatar-mask" wx:if="{{savingAvatar}}">上传中…</view>
        </button>
        <view class="avatar-tip">点击头像更换（微信头像）</view>
    </view>

    <!-- 昵称 -->
    <view class="card form-card">
        <view class="form-row">
            <text class="form-label">昵称</text>
            <input
                class="form-input"
                type="nickname"
                placeholder="请输入昵称"
                value="{{nickName}}"
                maxlength="20"
                bindinput="onNickInput"
            />
        </view>
        <view class="form-row">
            <text class="form-label">手机号</text>
            <text class="phone-text">{{phone}}</text>
        </view>
    </view>

    <view class="tip-text">昵称与头像保存到本机并同步服务器，重新登录后依然保留</view>

    <button class="btn btn-primary btn-block save-btn" bindtap="save">保存</button>
</view>

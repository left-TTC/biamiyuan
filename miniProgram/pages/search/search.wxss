/* pages/search/search.wxss */
page {
    height: 100vh;
    display: flex;
    flex-direction: column;
    background: #f5f6fa;
}

.search-page {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

/* 顶部搜索框 */
.search-head {
    display: flex;
    align-items: center;
    padding: 20rpx 24rpx;
    background: #f5f6fa;
    flex: none;
}

.search-box {
    flex: 1;
    display: flex;
    align-items: center;
    background: #ffffff;
    border-radius: 44rpx;
    height: 76rpx;
    padding: 0 28rpx;
}

.s-icon {
    font-size: 28rpx;
    margin-right: 12rpx;
}

.s-input {
    flex: 1;
    font-size: 28rpx;
}

.s-clear {
    color: #b0b6bf;
    font-size: 28rpx;
    padding: 8rpx;
}

.s-btn {
    margin-left: 20rpx;
    font-size: 28rpx;
    color: #1e6fff;
    font-weight: 600;
    flex: none;
}

.scrollarea {
    flex: 1;
    overflow-y: auto;
}

/* 输入联想 */
.suggest-list {
    background: #ffffff;
    flex: none;
}

.suggest-item {
    display: flex;
    align-items: center;
    padding: 24rpx 32rpx;
    border-bottom: 1rpx solid #f7f8fa;
}

.suggest-icon {
    font-size: 26rpx;
    color: #b0b6bf;
    margin-right: 16rpx;
}

.suggest-word {
    font-size: 28rpx;
    color: #1f2329;
}

/* 历史 & 热门 */
.block-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 28rpx 4rpx 8rpx;
}

.hot-head {
    margin-top: 40rpx;
}

.block-title {
    font-size: 30rpx;
    font-weight: 600;
    color: #1f2329;
}

.block-action {
    font-size: 24rpx;
    color: #9aa1ab;
    padding: 8rpx;
}

.tag-wrap {
    display: flex;
    flex-wrap: wrap;
    padding: 4rpx 0;
}

.h-tag {
    display: flex;
    align-items: center;
    background: #ffffff;
    color: #4b5563;
    font-size: 24rpx;
    padding: 12rpx 20rpx;
    border-radius: 32rpx;
    margin: 12rpx 16rpx 0 0;
}

.h-del {
    margin-left: 12rpx;
    color: #c0c6cf;
    font-size: 22rpx;
    padding: 2rpx;
}

.hot-tag {
    background: #ffffff;
    color: #1e6fff;
    font-size: 24rpx;
    padding: 12rpx 28rpx;
    border-radius: 32rpx;
    margin: 12rpx 16rpx 0 0;
    border: 1rpx solid rgba(30, 111, 255, 0.2);
}

/* 结果头部与排序 */
.result-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #ffffff;
    padding: 16rpx 24rpx;
    flex: none;
}

.result-count {
    font-size: 24rpx;
    color: #9aa1ab;
}

.sort-tabs {
    display: flex;
    align-items: center;
}

.sort-tab {
    display: flex;
    align-items: center;
    font-size: 26rpx;
    color: #6b7280;
    margin-left: 32rpx;
    padding: 6rpx 0;
}

.sort-tab.active {
    color: #1e6fff;
    font-weight: 600;
}

.sort-arrow {
    margin-left: 4rpx;
    font-size: 24rpx;
}

/* 商品网格（两列） */
.goods-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    padding-top: 20rpx;
}

.goods-card {
    width: 342rpx;
    background: #ffffff;
    border-radius: 20rpx;
    overflow: hidden;
    margin-bottom: 20rpx;
}

.goods-pic {
    height: 342rpx;
    display: flex;
    align-items: center;
    justify-content: center;
}

.goods-emoji {
    font-size: 140rpx;
}

.goods-img {
    width: 100%;
    height: 100%;
}

.goods-info {
    padding: 20rpx 22rpx 24rpx;
}

.goods-name {
    font-size: 28rpx;
    font-weight: 600;
    color: #1f2329;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.goods-desc {
    margin-top: 6rpx;
    font-size: 22rpx;
    color: #9aa1ab;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.goods-foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-top: 14rpx;
}

.goods-sales {
    font-size: 22rpx;
    color: #b0b6bf;
}


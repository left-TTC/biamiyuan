<!-- pages/index/index.wxml -->
<navigation-bar title="百米源监护" back="{{false}}" color="black" background="#F5F6FA"></navigation-bar>

<scroll-view class="scrollarea" scroll-y>
    <view class="page">
        <!-- 未登录：登录引导（设备与账号绑定，登录后才能查看） -->
        <view wx:if="{{!isLogin}}" class="login-prompt">
            <image
                class="login-prompt-icon"
                src="/assets/icons/LOCK.svg"
            />
            <view class="login-prompt-title">登录后查看我的设备</view>
            <view class="login-prompt-sub">设备与账号绑定 · 登录后可管理设备、接收报警通知</view>
            <view class="btn btn-primary login-prompt-btn" bindtap="goLogin">手机号登录 / 注册</view>
        </view>

        <block wx:if="{{isLogin}}">
            <!-- 守护状态概览 -->
            <view class="status-card {{stat.alarm > 0 ? 'danger' : ''}}">
                <view class="flex-1">
                    <view class="status-title">
                        <image
                            class="status-icon"
                            src="{{stat.alarm > 0 ? '/assets/icons/warning.svg' : '/assets/icons/sheild.svg'}}"
                            mode="aspectFit"
                        />
                        <text>{{stat.alarm > 0 ? '有设备报警' : '守护中'}}</text>
                    </view>
                    <view class="status-sub">在线 {{stat.online}} · 报警 {{stat.alarm}} · 离线 {{stat.offline}}</view>
                </view>
                <view class="unread-chip">
                    <text>未读 {{unread}}</text>
                </view>
            </view>

            <!-- 报警微信通知（订阅消息） -->
            <view class="notify-bar" bindtap="toggleNotify">
                <image
                    class="notify-icon"
                    src="/assets/icons/ALARM.svg"
                    mode="aspectFit"
                />
                <view class="flex-1">
                    <view class="notify-title">报警微信通知</view>
                    <view class="notify-sub">{{notifyOn ? '已开启，设备报警时通过微信提醒' : '开启后，设备报警将通过微信推送'}}</view>
                </view>
                <view class="switch {{notifyOn ? 'on' : ''}}">
                    <view class="switch-dot"></view>
                </view>
            </view>

            <!-- 我的设备（数量汇总，点击进入管理） -->
            <view class="section-title">我的设备</view>
            <view class="device-summary" bindtap="goDevices">
                <view class="summary-main">
                    <view class="summary-num">{{stat.total}}</view>
                    <view class="summary-label">台设备守护中</view>
                </view>
                <view class="summary-stats">
                    <view class="summary-pill pill-online">在线 {{stat.online}}</view>
                    <view class="summary-pill pill-alarm">报警 {{stat.alarm}}</view>
                    <view class="summary-pill pill-offline">离线 {{stat.offline}}</view>
                </view>
                <view class="summary-arrow">管理设备 ›</view>
            </view>

            <!-- 设备消息 -->
            <view class="section-title">
                <text>设备消息</text>
                <text wx:if="{{unread}}" class="section-unread">{{unread}} 条未读</text>
            </view>
            <view class="msg-card" wx:for="{{messages}}" wx:key="id" bindtap="tapMessage" data-id="{{item.id}}">
                <view class="msg-icon msg-{{item.type}}">
                    <text>{{item.emoji}}</text>
                </view>
                <view class="msg-info">
                    <view class="msg-title-row">
                        <text class="msg-title">{{item.title}}</text>
                        <view wx:if="{{!item.read}}" class="unread-dot"></view>
                    </view>
                    <view class="msg-content">{{item.content}}</view>
                    <view class="msg-time">{{item.timeText}}</view>
                </view>
            </view>
            <view wx:if="{{!messages.length}}" class="empty">
                <image
                    class="empty-icon"
                    src="/assets/icons/reportmailbox.svg"
                    mode="aspectFit"
                />
                <view class="empty-text">暂无设备消息，可先添加设备</view>
            </view>
        </block>

        <!-- 商城入口（弱化） -->
        <view class="mall-entry" bindtap="goMall">
            <text class="mall-icon"></text>
            <view class="flex-1">
                <view class="mall-title">安全监护商城</view>
                <view class="mall-sub">摄像头 · 报警器 · 看护设备</view>
            </view>
            <view class="mall-ops">
                <text class="mall-invite" catchtap="goInvite">邀请好友</text>
                <text class="mall-arrow">进入 ›</text>
            </view>
        </view>
    </view>
</scroll-view>



.tag-service {
    background: rgba(14, 165, 233, 0.12);
    color: #0ea5e9;
    font-size: 18rpx;
    margin-left: 6rpx;
}

.goods-source {
    margin-top: 4rpx;
    font-size: 20rpx;
    color: #0ea5e9;
}
page {
    height: 100vh;
    display: flex;
    flex-direction: column;
    background: #f5f6fa;
    /* 底部为自定义 tabBar 预留空间（100rpx 高度 + 安全区） */
    box-sizing: border-box;
    padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.cat-page {
    flex: 1;
    display: flex;
    overflow: hidden;
}

/* 搜索入口 */
.search-bar {
    display: flex;
    align-items: center;
    background: #ffffff;
    border-radius: 44rpx;
    height: 72rpx;
    padding: 0 28rpx;
    margin: 20rpx 24rpx 0;
    flex: none;
}

.search-icon {
    width: 18px;
    margin-right: 24rpx;
}

.search-text {
    font-size: 26rpx;
    color: #9aa1ab;
}

/* 服务器未连接提示条 */
.fallback-bar {
    margin: 16rpx 24rpx 0;
    background: #fff7e6;
    border: 1rpx dashed #f59e0b;
    border-radius: 16rpx;
    color: #b45309;
    font-size: 22rpx;
    padding: 12rpx 20rpx;
    flex: none;
}

/* 加载失败 */
.full-empty {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #b0b6bf;
}

.empty-tip {
    font-size: 24rpx;
    color: #9aa1ab;
    margin-top: 12rpx;
    text-align: center;
    padding: 0 60rpx;
    line-height: 1.7;
}

.retry-btn {
    margin-top: 28rpx;
}

/* 左侧分类 */
.left {
    width: 176rpx;
    background: #f0f1f4;
    height: 100%;
    flex: none;
}

.left-item {
    padding: 32rpx 0;
    text-align: center;
    position: relative;
}

.left-item.active {
    background: #f5f6fa;
    color: #1e6fff;
    font-weight: 600;
}

.left-item.active::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 6rpx;
    height: 36rpx;
    border-radius: 4rpx;
    background: #1e6fff;
}

.left-text {
    font-size: 26rpx;
}

/* 右侧商品 */
.right {
    flex: 1;
    height: 100%;
    background: #f5f6fa;
    padding: 0 20rpx;
}

/* 二级类目标签 */
.sub-scroll {
    width: 100%;
    flex: none;
    background: #f5f6fa;
}

.sub-tabs {
    display: flex;
    padding: 20rpx 0 12rpx;
    gap: 16rpx;
    white-space: nowrap;
}

.sub-tab {
    flex: none;
    font-size: 24rpx;
    color: #6b7280;
    background: #ffffff;
    border-radius: 28rpx;
    padding: 10rpx 28rpx;
    border: 1rpx solid #e5e7eb;
}

.sub-tab.active {
    color: #ffffff;
    background: linear-gradient(135deg, #1e6fff, #4d8dff);
    border-color: transparent;
    font-weight: 600;
}

.right-header {
    padding: 24rpx 8rpx 12rpx;
}

.right-title {
    font-size: 34rpx;
    font-weight: 700;
    color: #1f2329;
}

.right-desc {
    margin-top: 4rpx;
    font-size: 22rpx;
    color: #9aa1ab;
}

.goods-list {
    padding-bottom: 40rpx;
}

.goods-item {
    display: flex;
    background: #ffffff;
    border-radius: 20rpx;
    padding: 20rpx;
    margin-bottom: 20rpx;
}

.goods-pic {
    width: 160rpx;
    height: 160rpx;
    flex: none;
    border-radius: 16rpx;
    display: flex;
    align-items: center;
    justify-content: center;
}

.goods-emoji {
    font-size: 72rpx;
}

.goods-img {
    width: 100%;
    height: 100%;
}

.goods-info {
    flex: 1;
    margin-left: 20rpx;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.goods-name {
    font-size: 28rpx;
    font-weight: 600;
    color: #1f2329;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.goods-desc {
    margin-top: 6rpx;
    font-size: 22rpx;
    color: #9aa1ab;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.goods-foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-top: 10rpx;
}

.goods-sales {
    font-size: 22rpx;
    color: #b0b6bf;
}

/* pages/invite/invite.wxss */
page {
    height: 100vh;
    display: flex;
    flex-direction: column;
    background: #f5f6fa;
}

.scrollarea {
    flex: 1;
    overflow-y: auto;
}

/* 海报 */
.poster {
    position: relative;
    margin-top: 20rpx;
    border-radius: 24rpx;
    padding: 48rpx 40rpx;
    background: linear-gradient(135deg, #1e6fff, #4d8dff);
    color: #ffffff;
    overflow: hidden;
}

.poster-bg {
    position: absolute;
    right: -60rpx;
    top: -60rpx;
    width: 280rpx;
    height: 280rpx;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
}

.poster-head {
    text-align: center;
    justify-content: center;
    width: 100%;
}

.inviteTitle {
    display: flex;
    flex-direction: row;
    align-items: center;
    width: 100%;
    justify-content: center;
}

.poster-img {
    width: 25px;
    height: 25px;
    margin-right: 10px;
}

.poster-title {
    font-size: 40rpx;
    font-weight: 700;
    letter-spacing: 2rpx;
}

.poster-sub {
    margin-top: 8rpx;
    font-size: 26rpx;
    opacity: 0.9;
}

.poster-code {
    margin: 40rpx auto 0;
    width: 300rpx;
    background: rgba(255, 255, 255, 0.16);
    border-radius: 20rpx;
    padding: 24rpx 0;
    text-align: center;
    border: 2rpx dashed rgba(255, 255, 255, 0.5);
}

.code-label {
    font-size: 22rpx;
    opacity: 0.85;
}

.code-value {
    margin-top: 6rpx;
    font-size: 52rpx;
    font-weight: 700;
    letter-spacing: 10rpx;
}

.code-tip {
    margin-top: 8rpx;
    font-size: 22rpx;
    opacity: 0.85;
    text-decoration: underline;
}

.poster-rule {
    margin-top: 32rpx;
    font-size: 22rpx;
    text-align: center;
    opacity: 0.9;
    line-height: 1.7;
}

/* 统计 */
.stat-row {
    display: flex;
    background: #ffffff;
    border-radius: 20rpx;
    margin-top: 20rpx;
    padding: 28rpx 0;
}

.stat-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    border-right: 1rpx solid #f0f1f3;
}

.stat-item:last-child {
    border-right: none;
}

.stat-num {
    font-size: 36rpx;
    font-weight: 700;
    color: #1e6fff;
}

.stat-label {
    margin-top: 8rpx;
    font-size: 22rpx;
    color: #9aa1ab;
}

/* 绑定邀请码 */
.bind-card {
    margin-top: 20rpx;
}

.bind-title {
    font-size: 28rpx;
    font-weight: 600;
    color: #1f2329;
    display: flex;
    align-items: center;
}

.bind-img {
    width: 28rpx;
    height: 28rpx;
    margin-right: 10px;
}

.bind-desc {
    margin-top: 8rpx;
    font-size: 24rpx;
    color: #6b7280;
    line-height: 1.7;
}

.bind-row {
    display: flex;
    align-items: center;
    margin-top: 20rpx;
}

.bind-input {
    flex: 1;
    height: 80rpx;
    background: #f5f6fa;
    border-radius: 12rpx;
    padding: 0 24rpx;
    font-size: 24rpx;
    letter-spacing: 0rpx;
}

.bind-btn {
    margin-left: 20rpx;
    flex: none;
}

/* 分享 */
.share-btn {
    margin-top: 24rpx;
    display: flex;
    align-items: center;
    font-size: 15px;
}

.share-hint {
    margin-top: 12rpx;
    text-align: center;
    font-size: 22rpx;
    color: #b0b6bf;
}

.share-image {
    width: 20px;
    height: 20px;
    margin-right: 5px;
}

/* 菜单 */
.menu-item {
    display: flex;
    align-items: center;
    padding: 22rpx 4rpx;
}

.menu-icon {
    width: 24rpx;
    height: 24rpx;
    margin-right: 20rpx;
}

.menu-name {
    font-size: 28rpx;
    color: #1f2329;
    font-weight: 500;
}

.menu-desc {
    flex: 1;
    text-align: right;
    font-size: 24rpx;
    color: #9aa1ab;
    margin-right: 12rpx;
}

.menu-arrow {
    color: #c0c6cf;
    font-size: 32rpx;
}

/* 演示卡片 */
.demo-card {
    background: #fef9ec;
    border: 1rpx dashed #f59e0b;
}

.demo-title {
    font-size: 28rpx;
    font-weight: 600;
    color: #b45309;
}

.demo-desc {
    margin-top: 8rpx;
    font-size: 24rpx;
    color: #92400e;
    line-height: 1.7;
}

.demo-btn {
    margin-top: 20rpx;
    color: #b45309;
    border-color: #f59e0b;
    background: #ffffff;
}

/* 规则 */
.rule-title {
    font-size: 28rpx;
    font-weight: 600;
    color: #1f2329;
    margin-bottom: 16rpx;
}

.rule-item {
    font-size: 24rpx;
    color: #6b7280;
    line-height: 1.9;
}

/* 我邀请的好友列表 */
.invite-list-card {
    margin-top: 20rpx;
}

.list-title {
    font-size: 28rpx;
    font-weight: 600;
    color: #1f2329;
    padding-bottom: 16rpx;
    border-bottom: 1rpx solid #f0f1f3;
}

.invite-member {
    display: flex;
    align-items: center;
    padding: 24rpx 0;
    border-bottom: 1rpx solid #f7f8fa;
}

.invite-member:last-child {
    border-bottom: none;
}

.invite-avatar {
    width: 80rpx;
    height: 80rpx;
    border-radius: 50%;
    background: #eef4ff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 44rpx;
    flex: none;
}

.invite-info {
    flex: 1;
    margin-left: 20rpx;
}

.invite-name {
    font-size: 28rpx;
    font-weight: 600;
    color: #1f2329;
}

.invite-sub {
    margin-top: 6rpx;
    font-size: 22rpx;
    color: #b0b6bf;
}

.invite-tag {
    font-size: 20rpx;
    color: #b45309;
    background: #fef3c7;
    padding: 4rpx 12rpx;
    border-radius: 8rpx;
    flex: none;
}
